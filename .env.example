# SupplyIQ — Environment Configuration
# Copy this file to .env and fill in values as needed.
# The project runs completely fine with NO values set (LLM falls back to
# local template mode automatically) -- these are all optional enhancements.

# --- Reproducibility ---
RANDOM_SEED=42

# --- Database ---
# Path to the SQLite database file, relative to the project root.
SQLITE_DB_PATH=database/supplyiq.db

# --- GenAI / AI Analyst ---
# Leave LLM_PROVIDER=none (or blank) to run the AI Analyst in local
# template mode with zero API keys required -- fully functional, grounded
# on the same computed data, just without natural-language LLM synthesis.
#
# To enable LLM-backed answers, set:
#   LLM_PROVIDER=anthropic        (or "openai")
#   LLM_MODEL=claude-sonnet-4-5   (or an OpenAI model name if using openai)
#   LLM_API_KEY=sk-...            (your own API key -- never commit this)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
